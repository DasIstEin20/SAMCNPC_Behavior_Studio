{
  "schemaVersion": 1,
  "id": "tutorial:cautious_follow",
  "description": "Stop below 30% health; follow at or above 30%. No healing or fleeing.",
  "priority": 100,
  "channels": [
    "movement",
    "look"
  ],
  "rules": [
    {
      "id": "stop_when_hurt",
      "priority": 500,
      "when": {
        "test": {
          "condition": "samcnpc:health_fraction",
          "args": {
            "operator": "lt",
            "value": 0.3
          }
        }
      },
      "actions": [
        {
          "action": "samcnpc:stop_movement"
        }
      ]
    },
    {
      "id": "follow_when_healthy",
      "priority": 100,
      "when": {
        "all": [
          {
            "test": {
              "condition": "samcnpc:summoner_online"
            }
          },
          {
            "test": {
              "condition": "samcnpc:health_fraction",
              "args": {
                "operator": "gte",
                "value": 0.3
              }
            }
          }
        ]
      },
      "actions": [
        {
          "action": "samcnpc:move_to_summoner",
          "args": {
            "speed": 1.0,
            "stopDistance": 2.0
          }
        }
      ]
    }
  ]
}
